+    /// Drop a room from the local stores — the state store (and the room
+    /// held in memory) and the event cache store — the local half of
+    /// [`Room::forget`], for an app that forgot the room on the server by
+    /// other means. Sends nothing.
+    pub async fn forget_room_locally(&self, room_id: &RoomId) -> Result<()> {
+        Ok(self.base_client().forget_room(room_id).await?)
+    }
+
+    /// [`Self::forget_room_locally`], only while the room's state is one of
+    /// `states` — checked under the lock sync responses are processed under,
+    /// so a room the sync rejoined meanwhile is kept. Returns whether the room
+    /// was dropped.
+    pub async fn forget_room_locally_if(
+        &self,
+        room_id: &RoomId,
+        states: &[RoomState],
+    ) -> Result<bool> {
+        Ok(self.base_client().forget_room_if(room_id, states).await?)
+    }
