diff --git a/crates/matrix-sdk-base/src/store/mod.rs b/crates/matrix-sdk-base/src/store/mod.rs
index 88c2fae5e..e5ca11bbe 100644
--- a/crates/matrix-sdk-base/src/store/mod.rs
+++ b/crates/matrix-sdk-base/src/store/mod.rs
@@ -395,6 +395,18 @@ impl BaseStateStore {
         self.rooms.write().unwrap().remove(room_id);
         Ok(())
     }
+
+    /// [`Self::forget_room`] for a caller that holds [`Self::lock`] (the
+    /// store's own remove_room takes it, and it is not reentrant).
+    pub(crate) async fn forget_room_with_guard(
+        &self,
+        guard: &tokio::sync::MutexGuard<'_, ()>,
+        room_id: &RoomId,
+    ) -> Result<()> {
+        self.inner.remove_room_with_guard(guard, room_id).await?;
+        self.rooms.write().unwrap().remove(room_id);
+        Ok(())
+    }
 }
 
