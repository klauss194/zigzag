+            // zigzag patch 0002: the `pos` this request carried.
+            let request_pos = position_guard.pos.clone();
+
             // Handle the response.
             let updates = this
                 .handle_response(response, &mut position_guard, requested_required_states)
@@ -639,6 +656,17 @@ impl SlidingSync {
 
             this.cache_to_storage(&position_guard).await?;
 
+            // zigzag patch 0002: hand the body over, still under the position
+            // lock, so observers see responses in order and only handled ones.
+            if let (Some(observer), Some(body)) = (&this.inner.raw_response_observer, raw_body) {
+                (observer.0)(RawSlidingSyncResponse {
+                    request_pos,
+                    response_pos: position_guard.pos.clone().unwrap_or_default(),
+                    body,
