 crates/matrix-sdk/src/sliding_sync/mod.rs     | 39 +++++++-
 .../src/sliding_sync/raw_response.rs          | 98 +++++++++++++++++++
 3 files changed, 148 insertions(+), 1 deletion(-)
 create mode 100644 crates/matrix-sdk/src/sliding_sync/raw_response.rs

