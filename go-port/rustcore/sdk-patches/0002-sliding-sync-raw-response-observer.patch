diff --git a/crates/matrix-sdk/src/sliding_sync/raw_response.rs b/crates/matrix-sdk/src/sliding_sync/raw_response.rs
new file mode 100644
index 000000000..cd0ae6d73
--- /dev/null
+++ b/crates/matrix-sdk/src/sliding_sync/raw_response.rs
@@ -0,0 +1,98 @@
+// zigzag patch 0002 — see go-port/rustcore/SDK-PATCHES.txt in the zigzag repo.
+//
+// Hand every sliding sync response, VERBATIM (the HTTP body bytes as the
+// server sent them), to an optional observer — after the SDK has fully
+// processed it and persisted the new `pos`, before the next request is sent.
+//
+// Why bytes and not the parsed `http::Response`: ruma's v5 response models a
+// subset of what servers send (Synapse's `lists.*.ops`, for one, is dropped),
+// and an application that already folds the server's JSON itself must see
+// exactly what the server said.
+
+use std::{fmt, sync::Arc};
+
+use bytes::BufMut;
+use matrix_sdk_common::BoxFuture;
+use ruma::api::{
+    IncomingResponse, Metadata, OutgoingRequest,
+    auth_scheme::AuthScheme,
+    client::sync::sync_events::v5 as http,
+    error::{FromHttpResponseError, IntoHttpError},
+    path_builder::PathBuilder,
+};
+
+/// One sliding sync response as the server sent it.
+#[derive(Clone, Debug)]
+pub struct RawSlidingSyncResponse {
+    /// The `pos` the request carried; `None` means the request had no `pos`
+    /// (the response is a full window).
+    pub request_pos: Option<String>,
+
+    /// The `pos` the response carried, which is now this connection's
+    /// position.
+    pub response_pos: String,
+
+    /// The HTTP response body, byte for byte.
+    pub body: Vec<u8>,
+}
+
+/// An async callback receiving every [`RawSlidingSyncResponse`], in order.
+///
+/// Awaited on the task that handles the response, while the connection's
+/// position lock is still held: the next request is not sent before the
+/// returned future completes, so it can rely on the SDK's state reflecting
+/// exactly this response — and it must not take long.
+#[derive(Clone)]
+pub struct RawResponseObserver(
+    pub Arc<dyn Fn(RawSlidingSyncResponse) -> BoxFuture<'static, ()> + Send + Sync>,
+);
+
+impl fmt::Debug for RawResponseObserver {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("RawResponseObserver")
+    }
+}
+
+/// The v5 request, unchanged, whose response also keeps the body bytes.
+#[derive(Clone, Debug)]
+pub(super) struct KeepRawBody(pub http::Request);
+
+impl Metadata for KeepRawBody {
+    const METHOD: ::http::Method = <http::Request as Metadata>::METHOD;
+    const RATE_LIMITED: bool = <http::Request as Metadata>::RATE_LIMITED;
+    type Authentication = <http::Request as Metadata>::Authentication;
+    type PathBuilder = <http::Request as Metadata>::PathBuilder;
+    const PATH_BUILDER: Self::PathBuilder = <http::Request as Metadata>::PATH_BUILDER;
+}
+
+impl OutgoingRequest for KeepRawBody {
+    type EndpointError = <http::Request as OutgoingRequest>::EndpointError;
+    type IncomingResponse = WithRawBody;
+
+    fn try_into_http_request<T: Default + BufMut + AsRef<[u8]>>(
+        self,
+        base_url: &str,
+        authentication_input: <Self::Authentication as AuthScheme>::Input<'_>,
+        path_builder_input: <Self::PathBuilder as PathBuilder>::Input<'_>,
+    ) -> Result<::http::Request<T>, IntoHttpError> {
+        self.0.try_into_http_request(base_url, authentication_input, path_builder_input)
+    }
+}
+
+/// The parsed v5 response plus the body it was parsed from.
+pub(super) struct WithRawBody {
+    pub response: http::Response,
+    pub body: Vec<u8>,
+}
+
+impl IncomingResponse for WithRawBody {
+    type EndpointError = <http::Request as OutgoingRequest>::EndpointError;
+
+    fn try_from_http_response<T: AsRef<[u8]>>(
+        response: ::http::Response<T>,
+    ) -> Result<Self, FromHttpResponseError<Self::EndpointError>> {
+        let body = response.body().as_ref().to_vec();
+        let response = http::Response::try_from_http_response(response)?;
+        Ok(Self { response, body })
+    }
+}
