             // Release the position guard lock.
             // It means that other responses can be generated and then handled later.
             drop(position_guard);
@@ -773,6 +801,15 @@ impl SlidingSync {
         Ok(self.inner.internal_channel_send(SlidingSyncInternalMessage::SyncLoopStop)?)
     }
 
+    /// zigzag patch 0002: the connection's current `pos` (restored from the
+    /// store at build time when `share_pos` is on), or `None` before the first
+    /// response of a fresh connection. Waits for a round in flight to finish
+    /// (the position lock is held for the whole round trip): read it before
+    /// starting to sync, then follow the observer.
+    pub async fn current_pos(&self) -> Option<String> {
+        self.inner.position.lock().await.pos.clone()
+    }
